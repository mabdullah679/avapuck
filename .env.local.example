# .env.local — the local mirror of GCP Secret Manager.
#
# Copy to `.env.local` and keep it current. `.env.local` is GITIGNORED.
#
# ── HOW THIS STAYS 1:1 WITH SECRET MANAGER ────────────────────────────────
#
# Each secret below is declared ONCE, with the Secret Manager name it
# corresponds to. Two ways to use it:
#
#   A. RESOLVED MODE (recommended)  — leave the *_VALUE lines empty and run
#      `make secrets-sync`. The script reads each SM_* name from Secret
#      Manager and writes `.env.local.resolved`, which the pipeline loads.
#      Nothing long-lived is stored in plaintext, and a rotation in GCP is
#      picked up on the next sync. Drift is structurally impossible.
#
#   B. LITERAL MODE — paste values into the *_VALUE lines for offline work.
#      Convenient, but these are real secrets sitting on disk, and they go
#      stale silently the moment anyone rotates in GCP. Use for local dev
#      only, never for anything shared.
#
# `make secrets-verify` checks that every name declared here actually exists
# in Secret Manager, and that nothing here has drifted from it.

# ── GCP project ───────────────────────────────────────────────────────────
# The project ID string, NOT the project number 58996819807.
#   gcloud projects describe 58996819807 --format='value(projectId)'
GCP_PROJECT_ID=avapuck
GCP_PROJECT_NUMBER=58996819807
GCP_SERVICE_ACCOUNT_EMAIL=jobuserrole@avapuck.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_CLIENT_ID=115687643699323188058

# Bootstrap credential. This one CANNOT come from Secret Manager -- reading
# from SM requires GCP auth already, so it is the chicken-and-egg exception.
# Either a key file path, or leave empty and use:
#   gcloud auth application-default login    (no key file at all -- preferred)
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json

# ── Secrets: name in Secret Manager -> optional literal override ──────────
# SM_*  = the resource name in Secret Manager (this is what keeps it 1:1)
# *_VALUE = literal override for offline work; leave empty in resolved mode

# Postgres warehouse password
SM_POSTGRES_PASSWORD=projects/58996819807/secrets/pipeline-postgres-password/versions/latest
POSTGRES_PASSWORD_VALUE=

# AES-256 master key for the crypto service (base64, 32 bytes)
SM_CRYPTO_MASTER_KEY=projects/58996819807/secrets/pipeline-crypto-master-key/versions/latest
CRYPTO_MASTER_KEY_VALUE=

# HMAC key for deterministic blind indexes (base64, 32 bytes)
SM_BLIND_INDEX_KEY=projects/58996819807/secrets/pipeline-blind-index-key/versions/latest
BLIND_INDEX_KEY_VALUE=

# IdP RSA private key for signing JWTs (PEM)
SM_IDP_SIGNING_KEY=projects/58996819807/secrets/pipeline-idp-signing-key/versions/latest
IDP_SIGNING_KEY_VALUE=

# Ranger admin password
SM_RANGER_ADMIN_PASSWORD=projects/58996819807/secrets/pipeline-ranger-admin-password/versions/latest
RANGER_ADMIN_PASSWORD_VALUE=

# Airflow Fernet key (encrypts connections in the metadata DB)
SM_AIRFLOW_FERNET_KEY=projects/58996819807/secrets/pipeline-airflow-fernet-key/versions/latest
AIRFLOW_FERNET_KEY_VALUE=
