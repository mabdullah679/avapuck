# The absence watchdog: consumes the control topic, serves /healthz.
#
# Its own image rather than Dockerfile.service on purpose: that image is shared
# by the IdP and the crypto service, which hold key material, and every library
# added there is a library that can reach the AES master key. The watchdog
# needs a Kafka client; the crypto service must not carry one.
FROM python:3.12-slim

WORKDIR /opt/pipeline
RUN pip install --no-cache-dir \
      "fastapi==0.115.6" "uvicorn[standard]==0.34.0" \
      "PyJWT[crypto]==2.10.1" "cryptography==44.0.0" \
      "requests==2.32.3" "jsonschema==4.24.0" "kafka-python==3.0.11"

COPY pipeline/  /opt/pipeline/pipeline/
COPY services/  /opt/pipeline/services/
COPY contracts/ /opt/pipeline/contracts/
ENV PYTHONPATH=/opt/pipeline PYTHONUNBUFFERED=1

RUN useradd -r -u 10001 svc && chown -R svc /opt/pipeline
USER svc
EXPOSE 8446
CMD ["uvicorn", "services.watchdog.app:app", "--host", "0.0.0.0", "--port", "8446"]
