# One image for the operational services: console, tap, scaler, watchdog.
#
# Separate from Dockerfile.service on purpose: that image is shared by the IdP
# and the crypto service, which hold key material, and every library added
# there is a library that can reach the AES master key. These four need a
# Kafka client, a Postgres driver and (the scaler only) the Docker SDK; the
# crypto service must carry none of them. Which service runs is the command.
FROM python:3.12-slim

WORKDIR /opt/pipeline
RUN pip install --no-cache-dir \
      "fastapi==0.115.6" "uvicorn[standard]==0.34.0" "python-multipart==0.0.20" \
      "PyJWT[crypto]==2.10.1" "cryptography==44.0.0" \
      "requests==2.32.3" "jsonschema==4.24.0" \
      "kafka-python==3.0.11" "psycopg2-binary==2.9.10" "docker==7.2.0"

COPY pipeline/  /opt/pipeline/pipeline/
COPY services/  /opt/pipeline/services/
COPY contracts/ /opt/pipeline/contracts/
COPY config/traffic_profile.json /opt/pipeline/config/traffic_profile.json
ENV PYTHONPATH=/opt/pipeline PYTHONUNBUFFERED=1

RUN useradd -r -u 10001 svc && chown -R svc /opt/pipeline
USER svc
