# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is a secret VALUE -- these are pointers and non-secret settings.
# The only actual credential is the key file at secrets/gcp-sa.json.

# ── GCP ───────────────────────────────────────────────────────────────────
# The project ID (a string like "my-project-123"), NOT the project number.
#   gcloud projects describe <NUMBER> --format='value(projectId)'
GCP_PROJECT_ID=

# Path to the service-account key. Relative to the repo root.
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json

# ── BigQuery cost controls ────────────────────────────────────────────────
# BigQuery bills BYTES SCANNED, not rows returned. LIMIT does not reduce cost.
# maximum_bytes_billed is the hard stop: BigQuery REJECTS a query that would
# scan more than this rather than running it and billing you.
BQ_DATASET=bigquery-public-data.austin_bikeshare
BQ_TABLE=bikeshare_trips
BQ_ROW_LIMIT=100
BQ_MAX_BYTES_BILLED=52428800          # 50 MiB. A run should use far less.
BQ_LOCATION=US

# ── Services ──────────────────────────────────────────────────────────────
IDP_URL=https://localhost:8443
CRYPTO_URL=https://localhost:8444
IDP_AUDIENCE=wps-pipeline
IDP_ISSUER=https://idp.local

# ── Warehouse ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=analytics
POSTGRES_USER=pipeline
# Set in .env; never commit a real value.
POSTGRES_PASSWORD=

# ── Ranger / Hive ─────────────────────────────────────────────────────────
RANGER_URL=http://localhost:6080
RANGER_SERVICE_NAME=hive_pipeline
HIVE_HOST=localhost
HIVE_PORT=10000
