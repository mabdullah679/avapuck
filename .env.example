# ─────────────────────────────────────────────────────────────────────────────
# avapuck — the ONE place every value lives.
#
#   cp .env.example .env.local        # setup.sh does this on first run
#   ./setup.sh --merge-env            # appends variables a newer template added
#
# .env.local is gitignored and is the single contact point for the whole
# stack: docker-compose.yml carries no built-in defaults, so a variable
# missing here fails `up` by name. Wire your own secrets manager into
# .env.local however your org does it; nothing else needs to change.
# docs/DECISIONS.md D12.
#
# The values below are DEV DEFAULTS. Every password and secret must change
# before this runs anywhere shared. Empty values are deliberate where noted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity provider: one client secret per job ────────────────────────────
CLIENT_SECRET_EXTRACT_JOB=dev-extract-secret
CLIENT_SECRET_SPARK_JOB=dev-spark-secret
CLIENT_SECRET_HIVE_JOB=dev-hive-secret
CLIENT_SECRET_POSTGRES_JOB=dev-postgres-secret
CLIENT_SECRET_REPORT_JOB=dev-report-secret
# May ask the IdP to sign run verdicts, and nothing else.
CLIENT_SECRET_ORCHESTRATOR_JOB=dev-orchestrator-secret
# The console's admin PASSWORD (http://localhost:8447). Forwarded to the IdP as
# this client's secret; the console never stores it. docs/DECISIONS.md D20.
CLIENT_SECRET_CONSOLE_ADMIN=console-dev-password
# RS256 private key, PEM. Empty = ephemeral key per start (dev only): tokens
# and verdict signatures then do not survive an IdP restart.
IDP_SIGNING_KEY=

# ── Crypto service ──────────────────────────────────────────────────────────
# Empty = a new master key per start, and ALL prior ciphertext becomes
# permanently unreadable (TRUST-BOUNDARY 2.2). Set both before keeping data,
# and before giving the crypto service more than one worker process.
CRYPTO_MASTER_KEY=
BLIND_INDEX_KEY=

# ── Warehouse ───────────────────────────────────────────────────────────────
POSTGRES_DB=analytics
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline-dev-password
HIVE_METASTORE_PASSWORD=hive-dev-password

# ── Airflow ─────────────────────────────────────────────────────────────────
# The admin login for the Airflow UI (http://localhost:8085) and the REST API
# the console uses to start runs. Written into Airflow's passwords file at
# container start by docker/airflow-entrypoint.sh.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflow-dev-password

# ── Console ─────────────────────────────────────────────────────────────────
CONSOLE_ADMIN_USER=admin
# Signs the session cookie. Any long random string; rotate to log everyone out.
CONSOLE_SESSION_SECRET=change-me-to-a-long-random-string
# How long a browser stays signed in. 30 days.
CONSOLE_SESSION_SECONDS=2592000
# Dev auto-login (docs/DECISIONS.md D23): a browser on this machine gets a
# session without typing the password; the console signs in to the IdP itself
# with CLIENT_SECRET_CONSOLE_ADMIN. Set to false anywhere else.
CONSOLE_DEV_AUTOLOGIN=true
# Row cap for uploads through the console. 0 = uncapped (docs/DECISIONS.md D16).
# The scheduled BigQuery source keeps its own 100-row cap regardless.
UPLOAD_MAX_ROWS=0
# Rows per chunk through every stage. Every crypto call is one chunk wide.
PIPELINE_BATCH_ROWS=5000

# ── Traffic audit (docs/DECISIONS.md D18) ───────────────────────────────────
# Profile: config/traffic_profile.json. A breach blocks for this long.
TRAFFIC_BLOCK_SECONDS=300
# Networks the IdP never blocks: the compose network, so the pipeline's own
# token requests cannot be cut off by a flood at the front door. The console
# allowlists NOTHING; browser traffic is what it audits.
TRAFFIC_ALLOWLIST_INTERNAL=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ── Spark scaling (docs/DECISIONS.md D17) ───────────────────────────────────
# The scaler has the Docker socket (root on the host). Set SCALER_ENABLED=false
# to keep it observing and recommending without acting.
SPARK_WORKERS_MIN=2
SPARK_WORKERS_MAX=6
SCALER_ENABLED=true
SCALER_POLL_SECONDS=15
SCALER_COOLDOWN_SECONDS=120
SCALER_UP_THRESHOLD=0.8
SCALER_DOWN_THRESHOLD=0.2

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_ENCRYPTED=rpos_encrypted
KAFKA_TOPIC_PUBLIC=rpos_flat
KAFKA_TOPIC_CONTROL=pipeline_runs
# One password per principal. ACLs in docker/kafka-init.sh decide what each
# may do: pipeline writes; consumer reads flat+control; ui describes and
# reads flat+control; watchdog reads control; tap reads flat+control into
# monitor.kafka_log. admin is the only super user.
KAFKA_ADMIN_PASSWORD=admin-dev-password
KAFKA_PIPELINE_PASSWORD=pipeline-dev-password
KAFKA_CONSUMER_PASSWORD=consumer-dev-password
KAFKA_UI_PASSWORD=ui-dev-password
KAFKA_WATCHDOG_PASSWORD=watchdog-dev-password
KAFKA_TAP_PASSWORD=tap-dev-password
# The Kafka UI's own login form (http://localhost:8090).
KAFKA_UI_LOGIN_USER=admin
KAFKA_UI_LOGIN_PASSWORD=kafka-ui-dev-password

# ── Watchdog ────────────────────────────────────────────────────────────────
# A verdict is ABSENT when none arrives within INTERVAL + GRACE of the last
# run slot. Match INTERVAL to the DAG schedule (0 */4 * * *). The console's
# "connected" preset uses the same window.
WATCHDOG_INTERVAL_HOURS=4
WATCHDOG_GRACE_MINUTES=30
# Datasets that MUST report, comma-separated. Empty = track whatever appears.
WATCHDOG_DATASETS=
# Slack/Teams-compatible incoming webhook, shared with the console's traffic
# alerts. Empty = log lines and /healthz only.
WATCHDOG_WEBHOOK_URL=

# ── Extract (the SCHEDULED source; uploads come through the console) ────────
# auto: BigQuery when GCP_PROJECT_ID is set, else the offline fixture.
# live | fixture | csv force a source. This is an env var on purpose: BigQuery
# is a billable source and there is no RBAC yet, so it is not switchable from
# the console (docs/DECISIONS.md D15).
EXTRACT_MODE=auto
# Empty = no cloud account needed; the fixture runs end to end.
GCP_PROJECT_ID=
# Path INSIDE the container; secrets/ is bind-mounted read-only at /secrets.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_TABLE=order_items
BQ_DATASET_NAME=rpos_transactions
BQ_SQL_FILE=/opt/pipeline/config/bq/rpos_transactions_cards.sql
# The 4-hour slot maps into this range. Dense enough that any slot yields 100 rows.
BQ_DATA_START=2025-01-01
BQ_DATA_END=2026-08-31
BQ_WINDOW_HOURS=24
# BigQuery attempts before falling back to CSV_FALLBACK_PATH.
BQ_ATTEMPTS=3
CSV_FALLBACK_PATH=/data/csv/BLM_CO_Q2_2026_Oil_and_Gas_Lease_Sale_-2400573660170243848.csv
# Hard stop on bytes scanned. 300 MiB.
BQ_MAX_BYTES_BILLED=314572800

# ── Jenkins (docker compose --profile ci) ───────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=jenkins-dev-password

# ── Ranger admin (docker compose --profile ranger) ──────────────────────────
RANGER_DB_PASSWORD=ranger-dev-password
RANGER_ADMIN_PASSWORD=rangerR0cks!
